<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBgPrimary"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="?attr/colorBgSecondary"
        android:elevation="6dp">

        <ImageButton
            android:id="@+id/btn_settings_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:tint="?attr/colorAccentPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preferences"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?android:textColorPrimary"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- APPEARANCE CARD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appearance"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:textColor="?attr/colorAccentSecondary"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/colorBgSecondary"
                android:padding="20dp"
                android:elevation="2dp"
                android:layout_marginBottom="24dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Theme Mode"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:textColorPrimary"/>
                
                <RadioGroup
                    android:id="@+id/rg_theme_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">
                    <RadioButton
                        android:id="@+id/rb_theme_system"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="System Default"
                        android:textColor="?android:textColorPrimary"/>
                    <RadioButton
                        android:id="@+id/rb_theme_light"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Light Mode"
                        android:textColor="?android:textColorPrimary"/>
                    <RadioButton
                        android:id="@+id/rb_theme_dark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dark Mode"
                        android:textColor="?android:textColorPrimary"/>
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorBorder"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accent Color"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:textColorPrimary" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">
                    
                    <LinearLayout
                        android:id="@+id/ll_accent_colors"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <!-- Accent colors will be added here dynamically in code -->
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- DATA & BACKUP CARD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data &amp; Backup"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:textColor="?attr/colorAccentSecondary"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/colorBgSecondary"
                android:padding="20dp"
                android:elevation="2dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Export &amp; Import Workspace"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:textColorPrimary"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btn_export_json"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Export Backup (JSON)"
                    android:textColor="@color/text_on_accent"
                    android:backgroundTint="?attr/colorAccentPrimary"/>

                <Button
                    android:id="@+id/btn_import_json"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="Import Backup (JSON)"
                    android:textColor="?attr/colorAccentPrimary"
                    android:backgroundTint="?attr/colorBgTertiary"/>

            </LinearLayout>

            <!-- PDF EXPORT CARD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Print &amp; Share"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:textColor="?attr/colorAccentSecondary"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/colorBgSecondary"
                android:padding="20dp"
                android:elevation="2dp"
                android:layout_marginBottom="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save all data to a single PDF document."
                    android:textSize="14sp"
                    android:textColor="?android:textColorPrimary"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btn_export_pdf_all"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Export All to PDF"
                    android:textColor="@color/text_on_accent"
                    android:backgroundTint="?attr/colorAccentSecondary"/>

            </LinearLayout>

            <!-- VERSION INFO -->
            <TextView
                android:id="@+id/tv_app_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NoteCalc v1.3.0"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="?android:textColorSecondary"
                android:layout_marginBottom="40dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
