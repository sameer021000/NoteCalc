<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBgPrimary"
    android:padding="20dp">

    <!-- Header Section (Title + Create Buttons) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <ImageView
                android:id="@+id/btn_dashboard_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="?attr/colorAccentSecondary"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <TextView
                android:id="@+id/text_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
            <TextView
                android:id="@+id/text_app_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textSize="12sp"
                android:textColor="?attr/colorAccentSecondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView
                android:id="@+id/btn_create_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ List"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:padding="8dp"
                android:background="?attr/colorBgSecondary"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>
                
            <TextView
                android:id="@+id/btn_create_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Group"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:padding="8dp"
                android:background="?attr/colorBgSecondary"
                android:clickable="true"
                android:focusable="true"/>

            <ImageView
                android:id="@+id/btn_settings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:src="@android:drawable/ic_menu_preferences"
                android:tint="?attr/colorAccentSecondary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Settings"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Dashboard Search Bar -->
    <EditText
        android:id="@+id/edit_dashboard_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search lists &amp; groups…"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:singleLine="true"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/colorBgSecondary"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawableEnd="@drawable/ic_close"
        android:drawableTint="@color/text_tertiary"
        android:drawablePadding="8dp"
        android:visibility="gone"
        tools:ignore="Autofill,TextFields" />


    <!-- Container for List View and Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/dashboard_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Groups Section -->
            <LinearLayout
                android:id="@+id/section_groups"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.8"
                android:orientation="vertical"
                android:visibility="gone">
                
                <include layout="@layout/item_dashboard_group_header" />
                
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list_groups"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical" />
            </LinearLayout>

            <!-- Accounts Section -->
            <LinearLayout
                android:id="@+id/section_accounts"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.2"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">
                
                <include layout="@layout/item_dashboard_header" />
                
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list_accounts"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical" />
            </LinearLayout>
        </LinearLayout>

        <!-- Empty State Card (Visible when there are no accounts) -->
        <LinearLayout
            android:id="@+id/card_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/colorBgSecondary">

            <TextView
                android:id="@+id/text_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_state_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center" />

            <TextView
                android:id="@+id/text_empty_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_state_desc"
                android:textSize="14sp"
                android:textColor="?attr/colorAccentSecondary"
                android:gravity="center"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
