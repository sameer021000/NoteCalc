<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/trash_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBgPrimary"
    android:padding="8dp"
    android:visibility="gone">

    <!-- Header navigation bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="5dp">

        <ImageView
            android:id="@+id/btn_trash_list_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorAccentSecondary"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/text_trash_list_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="List Title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:singleLine="true"
            android:padding="8dp"
            android:background="@android:color/transparent" />

        <ImageView
            android:id="@+id/btn_trash_list_restore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert" 
            app:tint="?attr/colorAccentSecondary"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Restore Option" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorBorder"
        android:layout_marginBottom="10dp" />

    <!-- Mode Toggle: Expenses vs Budget -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/btn_trash_mode_expenses"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/editor_tab_expenses"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="@color/text_on_accent"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_trash_mode_budget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/editor_tab_budget"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="@color/text_tertiary"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Bulk actions bar (shown when items are selected) -->
    <LinearLayout
        android:id="@+id/trash_container_bulk_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:visibility="gone"
        android:layout_marginBottom="8dp"
        android:paddingEnd="8dp"
        tools:ignore="RtlSymmetry">

        <TextView
            android:id="@+id/trash_text_selected_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/editor_total_placeholder"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginEnd="16dp" />
            
    </LinearLayout>

    <!-- Table Header Row -->
    <LinearLayout
        android:id="@+id/trash_table_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="?attr/colorBgSecondary"
        android:layout_marginBottom="4dp">

        <CheckBox
            android:id="@+id/trash_cb_select_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.10"
            android:button="@drawable/ic_checkbox_selector"
            app:buttonTint="@null"
            android:gravity="center"
            android:padding="0dp"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/trash_th_sno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.12"
            android:text="@string/th_sno"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorAccentSecondary"
            android:gravity="center" />

        <TextView
            android:id="@+id/trash_th_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.32"
            android:text="@string/th_desc"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorAccentSecondary" />

        <TextView
            android:id="@+id/trash_th_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.23"
            android:text="@string/th_date"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorAccentSecondary"
            android:gravity="center" />

        <TextView
            android:id="@+id/trash_th_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.15"
            android:text="@string/th_amount"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorAccentSecondary"
            android:gravity="end" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/trash_list_records"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/trash_list_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Empty"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorAccentSecondary"
                android:gravity="center" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
