<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?attr/colorBgSecondary">

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/new_list_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/edit_new_list_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/new_list_hint"
        android:inputType="text"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:padding="12dp"
        android:background="?attr/colorBgPrimary"
        android:importantForAutofill="no"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/btn_dialog_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_cancel_edit_record"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/colorBgPrimary" />

        <TextView
            android:id="@+id/btn_dialog_create"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_list_btn_create"
            android:textColor="@color/text_on_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/colorAccentSecondary" />
    </LinearLayout>
</LinearLayout>
