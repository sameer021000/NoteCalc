                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical|end"
                    android:text="17"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_purple_secondary"
