<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_group_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/colorBgSecondary">

    <!-- Top Row: Title and Navigation Chevron -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_folder"
            android:layout_marginEnd="8dp"
            app:tint="?attr/colorAccentPrimary" />

        <TextView
            android:id="@+id/text_group_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Group Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:ellipsize="end"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/btn_pin_group"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_pin"
            app:tint="@color/text_tertiary"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="8dp"
            android:contentDescription="Pin Group" />

        <ImageView
            android:id="@+id/btn_delete_group"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="@color/error_red"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="8dp"
            android:contentDescription="Delete Group" />

    </LinearLayout>

    <!-- Bottom Row: Accounts in the group and Last Modified Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/text_group_accounts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Grocery, Rent, Utilities"
            android:textSize="13sp"
            android:textColor="?attr/colorAccentSecondary"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/text_group_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="17-06-2026"
            android:textSize="12sp"
            android:textColor="@color/text_tertiary"
            android:layout_marginStart="12dp" />
    </LinearLayout>
</LinearLayout>
