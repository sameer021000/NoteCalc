<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBgPrimary"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="?attr/colorBgSecondary"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btn_analytics_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:tint="?attr/colorAccentPrimary" />

        <TextView
            android:id="@+id/tv_analytics_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analytics"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:textColorPrimary"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Timeframe Selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="?attr/colorBgSecondary"
                android:padding="8dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <Spinner
                    android:id="@+id/spinner_timeframe"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:backgroundTint="?attr/colorAccentSecondary" />
                    
                <Button
                    android:id="@+id/btn_custom_range"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Custom"
                    android:textSize="12sp"
                    android:textColor="@color/text_on_accent"
                    android:backgroundTint="?attr/colorAccentSecondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_date_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="?attr/colorAccentSecondary"
                android:layout_marginBottom="16dp"
                android:text="Jan 1 - Jan 7" />

            <!-- Chart Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="?attr/colorBgSecondary"
                android:elevation="2dp"
                android:padding="8dp"
                android:layout_marginBottom="16dp">

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/chart_spending"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </LinearLayout>

            <!-- Insights Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Insights"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorAccentSecondary"
                android:layout_marginBottom="12dp" />

            <!-- Insight: Total & Budget -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/colorBgSecondary"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="12dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Spent"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="14sp" />
                
                <TextView
                    android:id="@+id/tv_total_spent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="?android:textColorPrimary"
                    android:textStyle="bold"
                    android:textSize="24sp"
                    android:layout_marginTop="4dp" />
                    
                <TextView
                    android:id="@+id/tv_budget_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0% of budget used"
                    android:textColor="?attr/colorAccentPrimary"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Insight: Daily Average -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="?attr/colorBgSecondary"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="12dp">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily Average"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tv_daily_avg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textColor="?android:textColorPrimary"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Highest Transaction"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tv_highest_txn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textColor="?android:textColorPrimary"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/colorBgSecondary"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Highest Spending Day"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_highest_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="None"
                    android:textColor="?android:textColorPrimary"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
