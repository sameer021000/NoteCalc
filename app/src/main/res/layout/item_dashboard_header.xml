<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp">
    <TextView
        android:id="@+id/label_saved_lists"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/saved_lists_label"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_tertiary" />
    <TextView
        android:id="@+id/btn_sort_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dashboard_header_sort_title"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="?attr/colorAccentSecondary"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginStart="4dp"
        android:clickable="true"
        android:focusable="true" />
    <TextView
        android:id="@+id/btn_sort_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dashboard_header_sort_total"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/text_tertiary"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginStart="4dp"
        android:clickable="true"
        android:focusable="true" />
    <TextView
        android:id="@+id/btn_sort_latest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dashboard_header_sort_latest"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/text_tertiary"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginStart="4dp"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
