<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?attr/colorBgSecondary">

    <!-- Title -->
    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/attach_file_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorAccentSecondary"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/btn_take_photo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/attach_file_btn_photo"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:padding="12dp"
        app:drawableStartCompat="@android:drawable/ic_menu_camera"
        app:drawableTint="?attr/colorAccentSecondary"
        android:drawablePadding="16dp"
        android:background="?attr/colorBgPrimary"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:id="@+id/btn_choose_file"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/attach_file_btn_file"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:padding="12dp"
        app:drawableStartCompat="@android:drawable/ic_menu_gallery"
        app:drawableTint="?attr/colorAccentSecondary"
        android:drawablePadding="16dp"
        android:background="?attr/colorBgPrimary"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>
